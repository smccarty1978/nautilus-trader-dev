    "timeframe_deltas_ns": {
      "1s": 1000000000,
      "1m": 60000000000,
      "3m": 180000000000,
      "5m": 300000000000
    }
  },
  "causal_rule": "FULL_BAR_OHLCV_AVAILABLE_ONLY_AT_INTERVAL_CLOSE"
}